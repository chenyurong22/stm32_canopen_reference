# Project-owned API documentation configuration.
PROJECT_NAME           = "STM32F767 CANopen Reference"
PROJECT_BRIEF          = "Project-owned CANopen runtime and device-profile interfaces"
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = App/Inc middleware/canopen/core middleware/canopen/port
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXTRACT_ALL             = NO
EXTRACT_STATIC          = NO
GENERATE_HTML           = YES
GENERATE_LATEX          = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
SORT_MEMBER_DOCS       = YES

# Vendor, generated, and build paths are intentionally excluded.
EXCLUDE                = third_party Generated build
